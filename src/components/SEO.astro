---
import { site } from "../content/site";

type JsonLd = Record<string, any>;
export type ArticleMeta = {
  publishedTime?: string;
  modifiedTime?: string;
  /** Visible byline; overrides the site author in the Article JSON-LD. */
  authorName?: string;
};

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt = "",
  robots = site.seo.robots ?? "index,follow",
  ogType = "website",
  article,
  jsonLd,
  themeColor = site.seo.themeColor ?? "#fbfbf9",
  themeColorDark = site.seo.themeColorDark,
} = Astro.props as {
  title?: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  robots?: string;
  ogType?: "website" | "article";
  article?: ArticleMeta;
  jsonLd?: JsonLd | JsonLd[];
  themeColor?: string;
  themeColorDark?: string;
};

// Title template: "Page | Site"; home (no/own-name title) shows the site name alone. (§1)
const pageName = title && title !== site.name ? title : undefined;
const fullTitle = pageName ? `${pageName} | ${site.name}` : site.name;

// OG/Twitter images must be absolute URLs for scrapers. (§5)
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : undefined;
const hasOg = Boolean(ogImageUrl);

const jsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
// JSON.stringify leaves "<" alone, so a value containing "</script>" would end
// the tag early. \u003c is the same character to a JSON parser.
const toJsonLd = (obj: unknown) => JSON.stringify(obj).replace(/</g, "\\u003c");

// Optional Search Console verification (site.seo.googleSiteVerification). (§1)
const gscVerification = site.seo.googleSiteVerification;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
{/* Two media-scoped values so the browser chrome follows the OS palette. */}
{
  themeColorDark ? (
    <>
      <meta
        name="theme-color"
        content={themeColor}
        media="(prefers-color-scheme: light)"
      />
      <meta
        name="theme-color"
        content={themeColorDark}
        media="(prefers-color-scheme: dark)"
      />
    </>
  ) : (
    <meta name="theme-color" content={themeColor} />
  )
}
{
  gscVerification && (
    <meta name="google-site-verification" content={gscVerification} />
  )
}

{/* Open Graph (§5) */}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageName ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
{hasOg && <meta property="og:image" content={ogImageUrl} />}
{
  hasOg && ogImageWidth && (
    <meta property="og:image:width" content={String(ogImageWidth)} />
  )
}
{
  hasOg && ogImageHeight && (
    <meta property="og:image:height" content={String(ogImageHeight)} />
  )
}
{hasOg && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
{
  ogType === "article" && article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  ogType === "article" && article?.modifiedTime && (
    <meta property="article:modified_time" content={article.modifiedTime} />
  )
}

{/* Twitter (§5) */}
<meta name="twitter:card" content={hasOg ? "summary_large_image" : "summary"} />
{
  site.seo.twitterSite && (
    <meta name="twitter:site" content={site.seo.twitterSite} />
  )
}
<meta name="twitter:title" content={pageName ?? site.name} />
<meta name="twitter:description" content={description} />
{hasOg && <meta name="twitter:image" content={ogImageUrl} />}

{/* Icons / PWA (§8) */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{
  jsonLdArray.map((obj) => (
    <script is:inline type="application/ld+json" set:html={toJsonLd(obj)} />
  ))
}
