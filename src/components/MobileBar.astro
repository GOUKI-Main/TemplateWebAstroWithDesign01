---
import { site } from "../content/site";
import { telHref } from "../lib/display";

// 画面下に常駐する導線（狭い画面のみ）。電話番号があれば「電話する」と
// 主導線（site.cta）の2つ、なければ主導線だけを横幅いっぱいに出す。
const tel = site.business?.telephone;
---

<div
  class:list={[
    "fixed inset-x-0 bottom-0 z-40 grid border-t border-border bg-bg pb-[env(safe-area-inset-bottom)] lg:hidden",
    tel ? "grid-cols-2" : "grid-cols-1",
  ]}
>
  {
    tel && (
      <a
        href={telHref(tel)}
        class="flex items-center justify-center gap-2 border-r border-border py-4 text-[0.8rem] tracking-[0.06em] text-fg no-underline"
      >
        電話する
      </a>
    )
  }
  <a
    href={site.cta.href}
    target={site.cta.external ? "_blank" : undefined}
    rel={site.cta.external ? "noopener" : undefined}
    class="flex items-center justify-center gap-2 bg-primary py-4 text-[0.8rem] tracking-[0.06em] text-on-primary no-underline"
  >
    {site.cta.label}
  </a>
</div>

<!-- 常駐バーの下に本文が隠れないよう、その高さぶんだけ余白を足す。 -->
<div class="h-14 lg:hidden" aria-hidden="true"></div>
