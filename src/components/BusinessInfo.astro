---
import { site } from "../content/site";
import {
  displayAddress,
  displayHours,
  displayTel,
  telHref,
} from "../lib/display";

// Visible NAP (Name / Address / Phone) for local businesses. Renders only when
// site.business is set — the same single source that drives the LocalBusiness
// JSON-LD, so structured data and the visible text always match. (§4 MEO)
// 表記だけ国内向けに整える（src/lib/display.ts）。値は変えない。
const b = site.business;
const address = displayAddress(b?.address);

const rows: {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
}[] = b
  ? [
      { label: "名称", value: b.legalName ?? site.name },
      ...(address ? [{ label: "所在地", value: address }] : []),
      ...(b.telephone
        ? [
            {
              label: "電話",
              value: displayTel(b.telephone),
              href: telHref(b.telephone),
            },
          ]
        : []),
      ...(b.email
        ? [{ label: "メール", value: b.email, href: `mailto:${b.email}` }]
        : []),
      ...(b.openingHours?.length
        ? [
            {
              label: "営業時間",
              value: b.openingHours.map(displayHours).join(" ／ "),
            },
          ]
        : []),
      ...(b.areaServed?.length
        ? [{ label: "対応エリア", value: b.areaServed.join("・") }]
        : []),
      ...(b.hasMap
        ? [
            {
              label: "地図",
              value: "Google マップで見る",
              href: b.hasMap,
              external: true,
            },
          ]
        : []),
    ]
  : [];
---

{
  b && (
    <dl class="not-prose tabular m-0" aria-label="事業者情報">
      {rows.map((row) => (
        <div class="spec-row">
          <dt class="m-0 w-40 shrink-0 text-[0.75rem] tracking-[0.08em] text-subtle">
            {row.label}
          </dt>
          <dd class="m-0 text-fg">
            {row.href ? (
              <a
                href={row.href}
                target={row.external ? "_blank" : undefined}
                rel={row.external ? "noopener" : undefined}
                class="link-rule text-[0.875rem]"
              >
                {row.value}
              </a>
            ) : (
              row.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}
